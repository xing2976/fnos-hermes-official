#!/bin/bash
# 安装前回调 — 清理残留进程
TRIM_PKGVAR="${TRIM_PKGVAR:-/vol1/@appdata/hermes-agent}"
LOG_FILE="${TRIM_PKGVAR}/info.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - [install_init] $1" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== install_init start ==="
pkill -9 -f "hermes.*monitor\.py" 2>/dev/null || true
pkill -9 -f "hermes.*gateway" 2>/dev/null || true
pkill -9 -f "hermes.*dashboard" 2>/dev/null || true
rm -f "${TRIM_PKGVAR}/hermes-agent.sock" 2>/dev/null || true
log_msg "install_init finished."
exit 0
